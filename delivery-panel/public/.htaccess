<IfModule mod_rewrite.c>
    # Enable Rewrite Engine
    RewriteEngine On
    
    # Detect the base path dynamically
    # For subdomain (delivery.phooldelivery.example), base path is /
    # For localhost, base path is /phool-delivery/delivery-panel/public/
    # This rewrite rule works for both by using relative paths
    
    # Don't rewrite actual files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite all requests to index.php (will be handled relative to this directory)
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Disable directory listing
Options -Indexes

# Deny access to sensitive directories if accidentally reachable
RedirectMatch 403 ^/(?:\.git|app|bootstrap|config|storage|tests|vendor|database)/.*$

# Deny access to environment files
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
