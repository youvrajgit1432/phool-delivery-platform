# Phool Delivery Platform — example environment.
# Copy to .env and adjust. NEVER commit a real .env.

APP_NAME="Phool Delivery"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/phool-delivery-platform
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=phool_delivery_demo
DB_USER=root
DB_PASSWORD=

MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Phool Delivery"

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional integrations (leave blank for the demo)
SMS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_API_KEY=
FIREBASE_SERVER_KEY=
FIREBASE_VAPID_PUBLIC_KEY=
FIREBASE_VAPID_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
