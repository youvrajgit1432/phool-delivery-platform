      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-256x256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-384x384.png",
      "sizes": "384x384",
