{
  "name": "Phool Vendor Panel",
  "short_name": "Phool Vendor",
  "description": "Vendor management panel for Phool Delivery - manage orders, products, earnings and deliveries",
  "start_url": "/vendor-panel/public/index.php",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#667eea",
  "orientation": "portrait-primary",
  "scope": "/vendor-panel/",
  "categories": ["business", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/vendor-panel/public/assets/img/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-144x144.png",
