      "purpose": "any maskable"
    },
    {
      "src": "/vendor-panel/public/assets/img/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/vendor-panel/public/assets/img/screenshot-mobile.jpg",
      "sizes": "375x667",
      "type": "image/jpeg",
      "form_factor": "narrow"
    },
    {
      "src": "/vendor-panel/public/assets/img/screenshot-desktop.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View vendor dashboard",
      "url": "/vendor-panel/public/index.php",
      "icons": [
        {
          "src": "/vendor-panel/public/assets/img/icons/icon-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Orders",
      "short_name": "Orders",
      "description": "View and manage orders",
      "url": "/vendor-panel/app/views/orders/index.php",
      "icons": [
        {
          "src": "/vendor-panel/public/assets/img/icons/icon-orders.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Products",
      "short_name": "Products",
      "description": "Manage your products",
      "url": "/vendor-panel/app/views/products/index.php",
      "icons": [
        {
          "src": "/vendor-panel/public/assets/img/icons/icon-products.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Earnings",
      "short_name": "Earnings",
      "description": "View earnings and payouts",
      "url": "/vendor-panel/app/views/payouts/index.php",
      "icons": [
        {
          "src": "/vendor-panel/public/assets/img/icons/icon-earnings.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/vendor-panel/public/ajax/share-receive.php",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+vendor",
      "url": "/vendor-panel/public/index.php?ref=%s"
    }
  ]
}
