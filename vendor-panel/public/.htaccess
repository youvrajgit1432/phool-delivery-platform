<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Don't process requests for existing files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # Don't process requests for existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Redirect uploads directory to parent folder (for image serving)
    # This handles the case where public/uploads should serve from ../uploads
    RewriteCond %{REQUEST_URI} ^/uploads/
    RewriteRule ^uploads/(.*)$ /../uploads/$1 [L]
    
    # Rewrite all other requests to index.php with path as query parameter
    RewriteCond %{REQUEST_URI} !^/index\.php
    RewriteRule ^(.+)$ /index.php?__path=$1 [QSA,L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
