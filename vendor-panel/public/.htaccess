<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite actual files or directories
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to index.php (relative to this directory so it
    # works both under a subdomain root and under a local subdirectory)
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# Disable directory listing
Options -Indexes
